+// ---------------------------------------------------------------------------
+// Gold-orange "mirror" button with an animated reflective sheen.
+// Used by _includes/contact-modal.html; add class="btn-sheen" to any button or link.
+// ---------------------------------------------------------------------------
+.btn-sheen {
+  position: relative;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  overflow: hidden;
+  isolation: isolate;
+  padding: 12px 26px;
+  border: 1px solid #b86a12;
+  border-radius: 999px;
+  cursor: pointer;
+  font-family: Monaco, "Bitstream Vera Sans Mono", "Lucida Console", Terminal, monospace;
+  font-size: 15px;
+  font-weight: bold;
+  letter-spacing: 0.04em;
+  color: #2b1600;
+  text-decoration: none;
+  text-shadow: 0 1px 0 rgba(255, 240, 200, 0.6);
+  // Polished-metal base: bright gold top, deep orange middle, warm glow at the bottom
+  background: linear-gradient(180deg,
+    #fff1b8 0%, #ffd45c 18%, #f7a823 48%, #e9781a 52%, #f59a2a 78%, #ffc964 100%);
+  box-shadow:
+    inset 0 1px 0 rgba(255, 255, 255, 0.85),   // top edge highlight
+    inset 0 -2px 3px rgba(120, 50, 0, 0.45),   // bottom edge shading
+    0 0 0 1px rgba(0, 0, 0, 0.4),
+    0 4px 14px rgba(245, 150, 30, 0.35);        // warm glow
+  transition: transform 0.15s ease, box-shadow 0.2s ease, filter 0.2s ease;
+
+  // Mirror gloss on the upper half
+  &::after {
+    content: "";
+    position: absolute;
+    inset: 1px 1px 50% 1px;
+    border-radius: 999px 999px 40% 40% / 999px 999px 20% 20%;
+    background: linear-gradient(180deg, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0.05));
+    pointer-events: none;
+    z-index: -1;
+  }
+
+  // Moving reflection that sweeps across the button
+  &::before {
+    content: "";
+    position: absolute;
+    top: -50%;
+    left: 0;
+    width: 45%;
+    height: 200%;
+    background: linear-gradient(90deg,
+      rgba(255, 255, 255, 0) 0%,
+      rgba(255, 255, 255, 0.15) 30%,
+      rgba(255, 255, 255, 0.9) 50%,
+      rgba(255, 255, 255, 0.15) 70%,
+      rgba(255, 255, 255, 0) 100%);
+    transform: translateX(-160%) skewX(-22deg);
+    animation: btn-sheen-sweep 3.2s ease-in-out infinite;
+    pointer-events: none;
+    z-index: 1;
+  }
+
+  .btn-sheen__label {
+    position: relative;
+    z-index: 2;
+  }
+
+  &:hover {
+    transform: translateY(-1px);
+    filter: brightness(1.06) saturate(1.1);
+    box-shadow:
+      inset 0 1px 0 rgba(255, 255, 255, 0.9),
+      inset 0 -2px 3px rgba(120, 50, 0, 0.45),
+      0 0 0 1px rgba(0, 0, 0, 0.4),
+      0 6px 22px rgba(255, 170, 40, 0.55);
+
+    &::before {
+      animation-duration: 1.1s;   // sheen speeds up on hover
+    }
+  }
+
+  &:active {
+    transform: translateY(1px);
+    filter: brightness(0.96);
+  }
+
+  &:focus-visible {
+    outline: 2px solid #b5e853;
+    outline-offset: 3px;
+  }
+}
+
+a.btn-sheen,
+a.btn-sheen:hover,
+a.btn-sheen:visited {
+  color: #2b1600;
+  text-decoration: none;
+}
+
+// Sweep across, then rest before the next pass
+@keyframes btn-sheen-sweep {
+  0%   { transform: translateX(-160%) skewX(-22deg); }
+  45%  { transform: translateX(330%) skewX(-22deg); }
+  100% { transform: translateX(330%) skewX(-22deg); }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .btn-sheen::before { animation: none; opacity: 0; }
+  .btn-sheen, .btn-sheen:hover { transition: none; transform: none; }
+}
